{
  "name": "ae-mcp",
  "version": "1.0.0",
  "description": "Advanced After Effects MCP server for motion graphics productivity",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "main": "dist/index.js",
  "bin": {
    "ae-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "after-effects",
    "mcp",
    "motion-graphics",
    "animation",
    "adobe"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
